########################################################################
# Replai — 환경변수 (05_deploy.md 1절)
#
# 이 파일을 `.env.local`로 복사해 값을 채웁니다. `.env.local`은 커밋하지 않습니다.
#
# ★ 철칙 — `NEXT_PUBLIC_` 접두사는 브라우저 번들에 문자열로 박힙니다.
#   빌드 시점에 인라인되므로 배포된 JS 파일을 열면 누구나 읽을 수 있고,
#   한 번 배포되면 되돌릴 수 없습니다.
#   AI 프로바이더 키와 Supabase service_role 키에 이 접두사를 붙이는 것은
#   즉시·영구 유출입니다. (고정 제약)
########################################################################


########################################################################
# 1. 공개 (NEXT_PUBLIC_ — 브라우저에 노출됨). 이 3개가 전부입니다.
#    새 NEXT_PUBLIC_ 변수를 추가하기 전에 "이 값이 배포된 JS에 평문으로
#    박혀도 되는가"에 먼저 답해야 합니다.
########################################################################

# Supabase 프로젝트 URL — 공개 엔드포인트입니다.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon 키 — RLS가 전제입니다. 사용자 데이터 테이블 전부에 RLS가 켜져 있고
# 정책이 소유자만 허용하므로 이 키만으로는 남의 데이터에 닿을 수 없습니다.
# RLS가 하나라도 꺼지면 이 키가 곧 전체 데이터 유출 경로가 됩니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 배포 URL — 절대 URL 생성(리다이렉트·메타데이터)에 씁니다. 로컬은 http://localhost:3000
NEXT_PUBLIC_SITE_URL=


########################################################################
# 2. 서버 전용 — 절대 NEXT_PUBLIC_ 금지
########################################################################

# ── Supabase ──────────────────────────────────────────────────────────
# ⚠️ RLS를 전면 무력화합니다. 전 사용자 데이터 읽기·쓰기·삭제가 가능합니다.
#    src/lib/supabase/admin.ts 에서만 읽습니다.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI 프로바이더 (D11 — Google 단독) ─────────────────────────────────
# google | anthropic. 기본 google
AI_PROVIDER=google

# Google AI Studio 키. 플래너·면접관·요약·평가·코치 전부 이 키를 씁니다.
# ⚠️ 이 키는 "체험 1회"(funding_source='trial_shared') 경로에서만 쓰입니다.
#    사용자 키(BYOK)는 환경변수가 아니라 Supabase Vault에 있습니다 (D28, 아래 4절).
GOOGLE_AI_API_KEY=

# 예산이 열릴 때의 전환용. MVP에서는 설정하지 않습니다.
ANTHROPIC_API_KEY=

# ── 역할별 모델 ID 오버라이드 ─────────────────────────────────────────
# 무료 티어 한도를 소진했을 때 배포 없이 모델을 내리기 위한 레버입니다.
# AI_MODEL_EVALUATOR를 flash로 내리는 것이 첫 번째 조정 레버입니다
# (Coach보다 먼저 내리지 않습니다 — 인용 정확도가 우선).
AI_MODEL_INTERVIEWER=
AI_MODEL_SUMMARIZER=
AI_MODEL_PLANNER=
AI_MODEL_EVALUATOR=
AI_MODEL_COACH=

# ── 내부 라우트 인증 ──────────────────────────────────────────────────
# 내부 워커 라우트(/api/internal/jobs/plan · /api/internal/jobs/evaluate)의 인증.
# 유출되면 누구나 평가 워커를 무한 호출해 무료 티어 쿼터를 태울 수 있습니다.
# 난수 32바이트를 권장하고, 환경마다 다른 값을 씁니다.
JOB_SECRET=

# 크론 라우트(/api/cron/daily)의 인증. Authorization: Bearer ${CRON_SECRET}
# 유출되면 워치독을 임의 실행해 세션을 강제 종료시킬 수 있습니다.
CRON_SECRET=

# ── 워치독 ────────────────────────────────────────────────────────────
WATCHDOG_EVALUATING_TIMEOUT_MIN=10
# D7 — paused 자동 종료 시한
PAUSED_AUTO_CLOSE_DAYS=7

# ── 예약 게이트 (D27) — 9종 전부 서버 전용 ────────────────────────────
# 한도 수치 자체는 비밀이 아니지만 하루 체험 정원이 그대로 계산되는 값이고,
# 그 숫자가 브라우저에 있으면 UI의 금칙어 규칙("무료 티어"·"한도"·"쿼터" 노출 금지)이
# 무의미해집니다. 클라이언트에 나가는 여력 정보는 GET /api/capacity 의 불리언과 시각뿐입니다.

# 게이트 전체 on/off. 사고 시 배포 없이 끄기 위한 스위치. 로컬은 false 권장.
AI_QUOTA_GATE_ENABLED=true

# ⚠️ 측정한 RPD 원값. 기본값 없음.
#    3종 중 하나라도 미설정이면 게이트는 열린 채로 동작합니다 (fail-open — 확정 동작).
#    주입 전까지 D27은 실질적으로 미적용 상태입니다.
AI_RPD_LIMIT_FLASH_LITE=
AI_RPD_LIMIT_FLASH=
# 가장 희소한 자원이라 체험 정원을 결정합니다.
AI_RPD_LIMIT_PRO=

# 안전 여유(%). limit_calls = floor(RPD × (1 − MARGIN/100))
AI_QUOTA_SAFETY_MARGIN_PCT=15

# quota_date 계산 타임존. Gemini의 RPD는 태평양 시간 자정에 리셋됩니다(2026-09-10 확인).
# UTC로 두면 최대 8시간 동안 예약과 실제 한도가 어긋납니다.
AI_QUOTA_RESET_TIMEZONE=America/Los_Angeles

# 세션당 예약량 (02_ai_architecture.md 8.3.1절)
AI_RESERVE_FLASH_LITE_PER_SESSION=26
AI_RESERVE_FLASH_PER_SESSION=4
AI_RESERVE_PRO_PER_SESSION=3


########################################################################
# 3. 여기에 없는 것 — 넣지 마세요
########################################################################
#
# ■ 사용자 API 키(BYOK, D28)는 환경변수가 아닙니다.
#   Supabase Vault의 암호문으로 저장되고 요청마다 복호화되며,
#   src/lib/ai/credentials.ts 한 곳에서만 읽힙니다.
#   사용자마다 키가 다르므로 "배포 단위 상수"인 환경변수라는 그릇 자체가 맞지 않습니다.
#   공용 키 폴백은 금지입니다 — 사용자 키가 죽어도 GOOGLE_AI_API_KEY로 넘어가는
#   코드 경로가 존재하면 안 됩니다.
#
# ■ 체험 동의 문구와 버전(D29)은 애플리케이션 상수입니다.
#   src/lib/consent/trial-consent.ts 한 파일이 원문과 CURRENT_TRIAL_CONSENT_VERSION을 갖습니다.
#   환경만 바꿔 문구를 바꿀 수 있으면 "무엇에 동의했는가"를 코드에서 답할 수 없습니다.
